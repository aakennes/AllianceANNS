{
  "schema_version": 3,
  "native_protocol": "alliance-formal-v1",
  "dataset": "laion10m",
  "notes": [
    "Uses the final LAION AIO observer timer; GT and replay outside the timed batch.",
    "Runtime bindings pin every input/binary SHA and this exact profile; EF coverage is explicitly bound, never auto-selected."
  ],
  "defaults": {
    "threads": 1,
    "metric": "ip",
    "bits": 3,
    "k": 10,
    "queries": 10000,
    "beam": 8,
    "rerank_beam": 8,
    "rerank_batch_blocks": 8,
    "quantization_source": "checkpoint",
    "shape": {
      "vectors": 10000000,
      "dimensions": 512,
      "wp": 6,
      "degree": 32,
      "max_layer": 6,
      "centroids": 128,
      "edge_bytes": 4096,
      "vector_bytes": 4096
    },
    "memory": {
      "mode": "phase",
      "loading_limit_bytes": 9663676416,
      "search_rss_limit_bytes": 3221225472
    },
    "cache": {
      "static_bytes": 205520896,
      "dynamic_bytes": 8388608,
      "clear_per_query": false,
      "auto_size": false
    },
    "entry": {
      "sampling": "guided",
      "samples": 256,
      "count": 4
    },
    "routing": {
      "filter_mode": "graph",
      "prefilter_threshold": 8192,
      "top_layer_postfilter": false
    },
    "aggregation": {
      "policy": "qps-paired-trim",
      "repeats": 5
    },
    "warmup_batches": 0,
    "batch_order": "repeat_then_ef",
    "malloc_arena_max": 4,
    "navigation": false,
    "input_formats": {
      "base": "fbin",
      "attributes": "ibin"
    },
    "ml_only": false
  },
  "workloads": {
    "mixed": {},
    "p1": {
      "routing": {
        "top_layer_postfilter": true
      }
    },
    "p4": {},
    "p7": {},
    "p10": {}
  }
}
